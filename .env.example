# Copy to .env (gitignored) for local development. App Service reads the same names from its settings.
AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_KEY=
# Optional: minimal | low | medium (default low)
AZURE_OPENAI_REASONING=medium
# Your PostgreSQL. On Windows the local `postgres` user has the password you set when installing:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/frostedcorner
# macOS/Linux with a passwordless local server can leave it unset (defaults to postgresql:///frostedcorner).
# SQLite is available as an explicit stand-in:  DATABASE_URL=sqlite:///tmp/frostedcorner-dev.db
